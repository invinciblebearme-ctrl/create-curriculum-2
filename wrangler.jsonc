{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-curriculum-2",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-curriculum2-db",
      "database_id": "0d9f2a7a-5670-4386-bca6-ed9e9079f6b1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "create-curriculum-storage"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "admin@school.ed.kr",
    "ADMIN_PASSWORD": "7703"
  }
}
